#!/bin/sh
set -eu

# Bun extracts OpenTUI's native render library before loading it. Meridian keeps
# /tmp mounted noexec, so use the Capsule's private, bounded home tmpfs instead.
BUN_TMPDIR="${BUN_TMPDIR:-/home/capsule/.cache/opencode/bun-tmp}"
mkdir -p "$BUN_TMPDIR"
chmod 0700 "$BUN_TMPDIR"
export BUN_TMPDIR

exec /usr/local/libexec/opencode "$@"
