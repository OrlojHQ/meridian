# DeepSeek Harness (developer preview, MIT), https://github.com/deepseek-ai/deepseek-harness
# Installed from npm with package-lock.json; Debian's unrelated `dsh` is
# rejected by PACK_IDENTITY.
PACK_NAME=dsh
PACK_VERSION=0.2.2-rc.1
PACK_LAYOUT=npm
PACK_PACKAGE=@deepseek-ai/dsh
PACK_ENTRY=lib/bin.js
PACK_IDENTITY=boot a DeepSeek Harness profile
