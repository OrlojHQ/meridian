# Antigravity CLI, https://antigravity.google/docs/cli/reference
# Google's installer reads a per-platform manifest
# (https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_<arch>.json)
# that names this archive and its SHA-512. The SHA-256 values below were
# computed from archives that matched those SHA-512 values. The version
# carries Google's build number; `agy --version` prints 1.5.14.
PACK_NAME=agy
PACK_VERSION=1.5.14-5302690847260672
PACK_URL=https://storage.googleapis.com/antigravity-public/antigravity-cli/{version}/{arch}.tar.gz
PACK_ARCH_AMD64=linux-x64/cli_linux_x64
PACK_ARCH_ARM64=linux-arm/cli_linux_arm64
PACK_SHA256_AMD64=d58386322d2073e96b33f7cc32b4e9ae2db6228f58440369725967b2de48c7b5
PACK_SHA256_ARM64=e5f69a3123fac66974b303d9a201f381a0fb32b3ef869d9139da85d5caf67a2a
PACK_LAYOUT=file
PACK_ENTRY=antigravity
PACK_IDENTITY=Start the Agent Client Protocol
