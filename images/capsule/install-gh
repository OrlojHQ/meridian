#!/bin/sh
# Install a pinned GitHub CLI into /usr/local/bin/gh.
# Checksums are the official release checksums for that tag.
set -eu
version=2.105.0
arch="${TARGETARCH:-amd64}"
case "$arch" in
  amd64) checksum=79e7ab5db738c48777b696e374f8b428f0647debfb424f44d2f426370407fe2f ;;
  arm64) checksum=b1278c75107423d818f1937fd92cafc9e5e9b606631568f68d7fb816f5885a02 ;;
  *) echo "unsupported GitHub CLI architecture: $arch" >&2; exit 1 ;;
esac
archive="gh_${version}_linux_${arch}.tar.gz"
curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
  "https://github.com/cli/cli/releases/download/v${version}/${archive}" \
  -o "/tmp/${archive}"
printf '%s  /tmp/%s\n' "$checksum" "$archive" | sha256sum -c -
tar -xzf "/tmp/${archive}" -C /tmp
install -m 0755 "/tmp/gh_${version}_linux_${arch}/bin/gh" /usr/local/bin/gh
rm -rf "/tmp/${archive}" "/tmp/gh_${version}_linux_${arch}"
