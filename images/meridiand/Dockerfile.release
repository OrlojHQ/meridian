# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
ARG TARGETPLATFORM
ARG VERSION
ARG COMMIT
ARG BUILD_DATE
COPY meridiand /usr/local/bin/meridiand
LABEL org.opencontainers.image.title="Meridian control plane" \
      org.opencontainers.image.description="Single-user self-hosted Meridian control plane" \
      org.opencontainers.image.source="https://github.com/OrlojHQ/meridian" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="Apache-2.0"
USER 65532:65532
WORKDIR /var/lib/meridian
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=5 CMD ["/usr/local/bin/meridiand", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/meridiand"]
CMD ["--provider=docker", "--listen=0.0.0.0:8080", "--preview-listen=127.0.0.1:8081", "--data-dir=/var/lib/meridian"]
