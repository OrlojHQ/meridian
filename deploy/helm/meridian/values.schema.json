{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "capsuleImage", "agentSandbox", "persistence", "networkPolicy"],
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "replicaCount": {"type": "integer", "const": 1},
    "namespace": {
      "type": "object", "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {"create": {"type": "boolean"}, "name": {"type": "string"}}
    },
    "image": {"$ref": "#/$defs/image"},
    "capsuleImage": {"$ref": "#/$defs/image"},
    "serviceAccount": {
      "type": "object", "additionalProperties": false,
      "required": ["create", "name", "automountServiceAccountToken"],
      "properties": {
        "create": {"type": "boolean"}, "name": {"type": "string"},
        "automountServiceAccountToken": {"type": "boolean", "const": true}
      }
    },
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {"type": "string", "const": "ClusterIP"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "agentSandbox": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace", "class", "runtimeClassName", "storageClassName", "workspaceSize", "ttl", "operationTimeout", "setupTimeout", "limits"],
      "properties": {
        "namespace": {"type": "string"}, "class": {"type": "string"},
        "runtimeClassName": {"type": "string"}, "storageClassName": {"type": "string"},
        "workspaceSize": {"type": "string", "minLength": 1},
        "ttl": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"},
        "operationTimeout": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"},
        "setupTimeout": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"},
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["cpu", "memory", "ephemeralStorage"],
          "properties": {
            "cpu": {"type": "string", "minLength": 1},
            "memory": {"type": "string", "minLength": 1},
            "ephemeralStorage": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "persistence": {
      "type": "object", "additionalProperties": false,
      "required": ["storageClassName", "size"],
      "properties": {"storageClassName": {"type": "string"}, "size": {"type": "string", "minLength": 1}}
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/$defs/resources"},
        "limits": {"$ref": "#/$defs/resources"}
      }
    },
    "podSecurityContext": {
      "type": "object", "additionalProperties": false,
      "required": ["runAsNonRoot", "runAsUser", "runAsGroup", "fsGroup", "seccompProfile"],
      "properties": {
        "runAsNonRoot": {"const": true},
        "runAsUser": {"type": "integer", "minimum": 1},
        "runAsGroup": {"type": "integer", "minimum": 1},
        "fsGroup": {"type": "integer", "minimum": 1},
        "seccompProfile": {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {"type": {"const": "RuntimeDefault"}}
        }
      }
    },
    "containerSecurityContext": {
      "type": "object", "additionalProperties": false,
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"],
      "properties": {
        "allowPrivilegeEscalation": {"const": false},
        "readOnlyRootFilesystem": {"const": true},
        "capabilities": {
          "type": "object", "additionalProperties": false, "required": ["drop"],
          "properties": {
            "drop": {
              "type": "array", "minItems": 1, "maxItems": 1,
              "items": {"const": "ALL"}
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "kubernetesAPIServerCIDRs", "dnsNamespaceSelector", "dnsPodSelector", "capsuleEgressCIDRs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "kubernetesAPIServerCIDRs": {"type": "array", "items": {"type": "string", "minLength": 3}},
        "dnsNamespaceSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "dnsPodSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "capsuleEgressCIDRs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "resourceQuota": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "hard"],
      "properties": {"enabled": {"type": "boolean"}, "hard": {"type": "object"}}
    },
    "podDisruptionBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "minAvailable"],
      "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"type": "integer", "minimum": 0}}
    }
  },
  "$defs": {
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "string", "minLength": 1},
        "memory": {"type": "string", "minLength": 1},
        "ephemeral-storage": {"type": "string", "minLength": 1}
      }
    }
  }
}
